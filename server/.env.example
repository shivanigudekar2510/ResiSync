# RESISYNC Server Environment Configuration
PORT=5000
NODE_ENV=development
DATABASE_URL="file:./dev.db" # Or postgresql://user:password@localhost:5432/resisync?schema=public
JWT_SECRET="replace_with_secure_random_jwt_secret"
CLIENT_URL="http://localhost:5173"
MOCK_PAYMENTS=true
MOCK_IOT=true

# External Service Credentials (Required for Live Production)
# RAZORPAY_KEY_ID="rzp_live_xxx"
# RAZORPAY_KEY_SECRET="xxx"
# AWS_S3_BUCKET="resisync-uploads"
# AWS_ACCESS_KEY_ID="xxx"
# AWS_SECRET_ACCESS_KEY="xxx"
# MQTT_BROKER_URL="mqtts://broker.example.com"

