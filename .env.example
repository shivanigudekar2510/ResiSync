# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_resisync_2026_change_in_production
CLIENT_URL=http://localhost:5173

# Database Configuration
# Local SQLite out-of-the-box development:
DATABASE_URL="file:./dev.db"
# Managed PostgreSQL Production:
# DATABASE_URL="postgresql://resisync_user:secure_password@db-host.internal:5432/resisync_db?schema=public"

# Mode Flags
MOCK_PAYMENTS=true
MOCK_IOT=true

# External Services (Provide keys when deploying to production with live gateways)
# RAZORPAY_KEY_ID="rzp_live_your_key_id"
# RAZORPAY_KEY_SECRET="your_live_key_secret"
# AWS_S3_BUCKET="resisync-society-documents"
# AWS_ACCESS_KEY_ID="your_aws_access_key"
# AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
# MQTT_BROKER_URL="mqtts://broker.resisync-iot.internal:8883"

