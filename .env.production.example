# ==========================================
# RESISYNC Production Environment Variables
# ==========================================

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=resisync_db_admin
POSTGRES_PASSWORD=generate_super_strong_password_here_128bit
POSTGRES_DB=resisync_production
DATABASE_URL=postgresql://resisync_db_admin:generate_super_strong_password_here_128bit@postgres:5432/resisync_production?schema=public

# Distributed Caching & Rate Limiting (Redis 7)
REDIS_PASSWORD=generate_strong_redis_password_64bit
REDIS_URL=redis://:generate_strong_redis_password_64bit@redis:6379

# JWT Authentication
JWT_SECRET=generate_256_bit_cryptographic_jwt_secret_key_minimum_64_characters
JWT_EXPIRES_IN=7d

# Network & Host
PORT=5000
NODE_ENV=production
CORS_ORIGIN=https://resisync.com,https://www.resisync.com

# Frontend Build Arguments
VITE_API_BASE_URL=https://api.resisync.com/api

# Real-time WebSockets
SOCKET_CORS_ORIGIN=https://resisync.com

# Firebase Cloud Sync Credentials (Optional / Production)
FIREBASE_PROJECT_ID=resisync-prod-cloud
FIREBASE_API_KEY=AIzaSyA4Q92xLmK71P0-v9eZ81jLmK71P0v9eZ8
FIREBASE_AUTH_DOMAIN=resisync-prod-cloud.firebaseapp.com
FIREBASE_STORAGE_BUCKET=resisync-prod-cloud.appspot.com
FIREBASE_MESSAGING_SENDER_ID=892104918231
FIREBASE_APP_ID=1:892104918231:web:d892a0194b18f0c29a88e1

# Payment Gateway Sandbox / Live
PAYMENT_GATEWAY_PROVIDER=MOCK
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
